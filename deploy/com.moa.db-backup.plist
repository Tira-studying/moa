<?xml version="1.0" encoding="UTF-8"?>
<!--
  모아 DB 매일 자동 백업 (macOS launchd 사용자 작업)
  설치·해제 방법은 deploy/BACKUP.md를 참고하세요. 경로는 Mac의 기본 위치 기준입니다.
  Mac이 잠자기 중이었다면 깨어난 뒤 한 번 실행합니다.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moa.db-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR-USER/moa-projects/moa/scripts/backup-db.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <!-- 두 번째 백업: NAS(Tailscale 주소)로 SSH 복사. 전용 키 ~/.ssh/moa_nas_backup 사용 -->
    <key>MOA_BACKUP_REMOTE</key>
    <string>YOUR-NAS-USER@NAS-TAILSCALE-IP:/volume1/moa-backup</string>
    <key>MOA_BACKUP_REMOTE_PORT</key>
    <string>22</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOUR-USER/moa-backups/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR-USER/moa-backups/launchd.log</string>
</dict>
</plist>
